 'transport-belt', position = { ox + p[1] + 0.5, oy + p[2] + 0.5 }, direction = defines.direction.south, force = f }\nend\nlocal eei = s.create_entity { name = 'electric-energy-interface', position = { ox - 6, oy + 1 }, force = f }\neei.power_production = 1e8 eei.electric_buffer_size = 1e9\nfor _, fd in pairs { {-2,-1,0,'iron-plate','west'},{-2,-1,1,'iron-plate','west'},{-2,-1,2,'iron-plate','west'},{-2,-1,3,'iron-plate','west'},{3,2,4,'copper-plate','east'},{3,2,5,'copper-plate','east'},{3,2,6,'copper-plate','east'},{3,2,7,'copper-plate','east'},{2,3,8,'steel-plate','west'},{2,3,9,'steel-plate','west'},{2,3,10,'steel-plate','west'},{2,3,11,'steel-plate','west'},{7,6,12,'stone-brick','east'},{7,6,13,'stone-brick','east'},{7,6,14,'stone-brick','east'},{7,6,15,'stone-brick','east'},{6,7,16,'plastic-bar','west'},{6,7,17,'plastic-bar','west'},{6,7,18,'plastic-bar','west'},{6,7,19,'plastic-bar','west'} } do\n  local y = oy + fd[3] + 0.5\n  local ch = s.create_entity { name = 'infinity-chest', position = { ox + fd[1] + 0.5, y }, force = f }\n  ch.set_infinity_container_filter(1, { name = fd[4], count = 100, index = 1 })\n  s.create_entity { name = 'fast-inserter', position = { ox + fd[2] + 0.5, y }, direction = defines.direction[fd[5]], force = f }\nend\n-- poles down both sides of the feed rows and across the bus head, every 6 tiles\nfor x = -4, 20, 6 do for y = -2, 26, 6 do\n  s.create_entity { name = 'medium-electric-pole', position = { ox + x + 0.5, oy + y + 0.5 }, force = f }\nend end\nlocal sinks = { 'production-science-pack','rail','electric-furnace','productivity-module','advanced-circuit','electronic-circuit','iron-stick','copper-cable','iron-gear-wheel' }\nfor _, e in pairs { {0},{1},{4},{5},{8},{9},{12},{13} } do\n  local x = ox + e[1] + 0.5\n  s.create_entity { name = 'fast-inserter', position = { x, oy + 130 + 0.5 }, direction = defines.direction.north, force = f }\n  local ch = s.create_entity { name = 'infinity-chest', position = { x, oy + 130 + 1.5 }, force = f }\n  for i, it in pairs(sinks) do ch.set_infinity_container_filter(i, { name = it, count = 0, mode = 'exactly', index = i }) end\nend\nfor x = -2, 20, 6 do s.create_entity { name = 'medium-electric-pole', position = { ox + x + 0.5, oy + 130 + 2.5 }, force = f } end\nfor k = 0, 17 do s.create_entity { name = 'medium-electric-pole', position = { ox + 50.5, oy - 3.5 + 8 * k }, force = f } end\nfor x = 20, 50, 8 do s.create_entity { name = 'medium-electric-pole', position = { ox + x + 0.5, oy - 3.5 }, force = f } end\nfor x = 20, 50, 8 do s.create_entity { name = 'medium-electric-pole', position = { ox + x + 0.5, oy + 130 + 2.5 }, force = f } end\nlocal chest = s.create_entity { name = 'steel-chest', position = { ox + 24.5, oy - 4.5 }, force = f }\nfor nm, k in pairs { ['assembling-machine-2']=80,['inserter']=250,['fast-inserter']=60,['transport-belt']=1500,['underground-belt']=150,['splitter']=30,['small-electric-pole']=100,['medium-electric-pole']=80,['iron-chest']=20,['long-handed-inserter']=30 } do chest.insert { name = nm, count = k } end\nlocal chest2 = s.create_entity { name = 'steel-chest', position = { ox + 25.5, oy - 4.5 }, force = f }\nchest2.insert { name = 'transport-belt', count = 800 }\nstorage.layout = storage.layout or {}\nstorage.layout['bus:main'] = { name = 'main', x = ox + 0.5, y = oy + 0.5, direction = 'south', side = 'east',\n  lanes = { 'iron-plate','copper-plate','steel-plate','stone-brick','plastic-bar','spare','spare','spare' }, length = 130, starts = {}, joins = { { kind = 'feed', lane = 0, at = 0, ['end'] = { ox + 0.5, oy + 0.5 } }, { kind = 'feed', lane = 0, at = 4, ['end'] = { ox + 0.5, oy + 0.5 } }, { kind = 'feed', lane = 0, at = 8, ['end'] = { ox + 0.5, oy + 0.5 } }, { kind = 'feed', lane = 0, at = 12, ['end'] = { ox + 0.5, oy + 0.5 } }, { kind = 'feed', lane = 0, at = 16, ['end'] = { ox + 0.5, oy + 0.5 } }, { kind = 'feed', lane = 0, at = 20, ['end'] = { ox + 0.5, oy + 0.5 } } } }\nlocal c = storage.agents and storage.agents['serf'] and storage.agents['serf'].char\nif c and c.valid then c.teleport { ox + 26, oy - 3 } end\nreturn { origin = { ox, oy } }\n",
